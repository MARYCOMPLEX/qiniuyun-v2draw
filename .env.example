# =============================================================
# voice-canvas 环境变量
# 按功能域划分；每域独立成块，避免跨域耦合。
# 仅留代码实际读取的字段；占位坑全部清理。
# =============================================================

# ─── 1. LLM (主链路, 必填) ───
# 走 OpenAI 兼容协议: 阿里云 DashScope / yunwu / 自建网关均可
# baseURL 不填走官方 OpenAI 端点
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_PROVIDER=openai-compatible
LLM_DEFAULT_MODEL=qwen3.7-plus

# ─── 2. ASR (语音识别, 阿里云实时识别 NLS) ───
# 留空时前端 utterance 走模拟器；ASR_PROVIDER=browser-webspeech 也可走浏览器内置
# Token 由后端用 AccessKey 动态换取并缓存, 不在此处手填
ASR_PROVIDER=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_NLS_APP_KEY=

# ─── 3. TTS (语音反馈, 阿里云 Qwen3-TTS-Realtime) ───
# 走 wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# 鉴权直接复用 OPENAI_API_KEY (DashScope 同一把 Key, 不另设变量)
# 留空则前端 TTS 开关置灰, 整链路降级为静音
TTS_PROVIDER=
TTS_VOICE=Cherry

# ─── 4. 生图 (业务自用通道, 不走 Provider Registry) ───
IMAGE2_API_KEY=
IMAGE2_URL=
