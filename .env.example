# OpenAI 兼容端点（Vercel AI SDK 使用）
# 仅在生产模式下需要；前端内置【数据流模拟器】可绕过此 Key
OPENAI_API_KEY=sk-SkiFhy0leTLvP4RCO0xohwF69W3xrFj44jsLtAkBf2LlVC1p
OPENAI_BASE_URL=https://yunwu.ai/v1
OPENAI_MODEL=gemini-3-flash-preview

# ─── Provider Registry (PR1: 仅占位, PR2+ 注入真实实现) ───
# LLM 主链路 — 留空回落到 null provider, 前端模拟器仍可用
# Provider 与 Model 解耦: yunwu / OpenAI / 自建网关都走 openai-compatible, model 运行时切
LLM_DEFAULT_PROVIDER=                      # openai-compatible | anthropic | google | mistral
LLM_DEFAULT_MODEL=                         # gpt-4o-mini / claude-haiku-4-5 / gemini-2.0-flash 等

# 按 toolType 分工 (可选, 缺省继承 LLM_DEFAULT_*)
# Why: ATOMIC_SHAPE 高频路由用小快模型, DIFFUSION_MELT 提示词润色用大模型
LLM_ATOMIC_SHAPE_PROVIDER=
LLM_ATOMIC_SHAPE_MODEL=
LLM_DIFFUSION_MELT_PROVIDER=
LLM_DIFFUSION_MELT_MODEL=
LLM_WEB_SEARCH_PROVIDER=
LLM_WEB_SEARCH_MODEL=

# 各 Provider 端点 + key (按需填一组即可)
# OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL 已在上方 (向后兼容)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=                        # 可选, 走代理时填
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_BASE_URL=
MISTRAL_API_KEY=
MISTRAL_BASE_URL=

# ASR 语音识别 — 留空时前端 utterance 由模拟器伪造
ASR_PROVIDER=                              # browser-webspeech | whisper-openai | deepgram | aliyun-nls
DEEPGRAM_API_KEY=
ALIYUN_NLS_APP_KEY=
ALIYUN_NLS_TOKEN=

# TTS 语音反馈 — 可选增强能力, 留空则前端开关置灰
TTS_PROVIDER=                              # openai | elevenlabs | aliyun-cosyvoice | azure
TTS_VOICE=
ELEVENLABS_API_KEY=
ALIYUN_TTS_APP_KEY=
ALIYUN_TTS_TOKEN=
AZURE_TTS_KEY=
AZURE_TTS_REGION=

# DIFFUSION_MELT 图像生成 — 留空时该工具在前端降级为占位
IMAGE_PROVIDER=                            # openai-dalle | stability | replicate | aliyun-wanxiang
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
ALIYUN_WANXIANG_API_KEY=

# WEB_SEARCH 搜索 — 留空时该工具在前端降级为占位
SEARCH_PROVIDER=                           # tavily | serper | brave | exa
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
