# OpenAI 兼容端点（Vercel AI SDK 使用）
# 仅在生产模式下需要；前端内置【数据流模拟器】可绕过此 Key
OPENAI_API_KEY=sk-SkiFhy0leTLvP4RCO0xohwF69W3xrFj44jsLtAkBf2LlVC1p
OPENAI_BASE_URL=https://yunwu.ai/v1
OPENAI_MODEL=gemini-3-flash-preview

# ─── Provider Registry (PR1: 仅占位, PR2+ 注入真实实现) ───
# LLM 主链路 — 留空回落到 null provider, 前端模拟器仍可用
LLM_PROVIDER=                              # openai-compatible | anthropic | google | mistral
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=

# ASR 语音识别 — 留空时前端 utterance 由模拟器伪造
ASR_PROVIDER=                              # browser-webspeech | whisper-openai | deepgram | aliyun-nls
DEEPGRAM_API_KEY=
ALIYUN_NLS_APP_KEY=
ALIYUN_NLS_TOKEN=

# TTS 语音反馈 — 可选增强能力, 留空则前端开关置灰
TTS_PROVIDER=                              # openai | elevenlabs | aliyun-cosyvoice | azure
TTS_VOICE=
ELEVENLABS_API_KEY=
ALIYUN_TTS_APP_KEY=
ALIYUN_TTS_TOKEN=
AZURE_TTS_KEY=
AZURE_TTS_REGION=

# DIFFUSION_MELT 图像生成 — 留空时该工具在前端降级为占位
IMAGE_PROVIDER=                            # openai-dalle | stability | replicate | aliyun-wanxiang
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
ALIYUN_WANXIANG_API_KEY=

# WEB_SEARCH 搜索 — 留空时该工具在前端降级为占位
SEARCH_PROVIDER=                           # tavily | serper | brave | exa
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
